# Copy to .env and fill in from your Supabase project settings (Project Settings → API).
# EXPO_PUBLIC_ vars are embedded in the app bundle — only the URL and the anon (public) key
# belong here. Service-role keys and Plaid secrets live in Supabase Edge Function secrets.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
