# Copy to .env and fill in from your Supabase dashboard (Settings → API Keys).
# EXPO_PUBLIC_ vars are embedded in the app bundle — only the URL and the publishable
# (anon/public) key belong here. Secret / service-role keys and Plaid secrets live in
# Supabase Edge Function secrets (see supabase/functions/.env.example).
EXPO_PUBLIC_SUPABASE_URL=
# Accepts a publishable key (sb_publishable_…, preferred) or a legacy anon key. Supabase
# deprecates anon/service_role keys at the end of 2026; the publishable key is a drop-in
# with identical RLS behaviour. Var name kept as-is so existing .env files still work.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional: the production project (real banks). Dev builds get a Sandbox / Real data switch in
# Settings; release builds always use it. Leave empty and everything stays on the project above.
EXPO_PUBLIC_PROD_SUPABASE_URL=
EXPO_PUBLIC_PROD_SUPABASE_KEY=
