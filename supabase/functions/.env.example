# Copy to .env and fill in. This file holds SECRETS — it is gitignored and never
# travels with the repo. Push it to the cloud with:
#   npx supabase secrets set --env-file supabase/functions/.env
#
# Plaid dashboard → Developers → Keys (https://dashboard.plaid.com/developers/keys)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# NOTE: do NOT add SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY here. Supabase injects
# those into Edge Functions automatically and reserves the SUPABASE_ prefix —
# `secrets set` rejects it. _shared/lib.ts reads them straight from Deno.env.

# Jev (TypeSafe AI) makes every AI decision since Phase 12d: categories, review
# priority, split hints, recurring tiebreaks. Without it the Jev passes are
# skipped silently and syncs are otherwise unaffected.
JEV_API_KEY=

# RevenueCat (Phase 14c). Dashboard → Project settings → API keys: the v1 SECRET key
# (never the public SDK key, which goes in apps/mobile/.env). The webhook secret is
# any long random string, set both here and as the webhook's Authorization header
# value in RevenueCat → Integrations → Webhooks. Without it, every webhook is refused.
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_SECRET=
