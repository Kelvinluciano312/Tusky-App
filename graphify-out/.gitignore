# Machine-local and regenerable. The graph agents read is committed:
# GRAPH_REPORT.md, graph.json, graph.html, manifest.json,
# .graphify_analysis.json, .graphify_labels.json, .graphify_labels.json.sig.

# Absolute interpreter path and scan root. A local extract writes the
# machine path here (this build wrote /workspace).
.graphify_python
.graphify_root

# AST and stat cache. Regenerated by `graphify extract` / `graphify update`.
cache/

# LLM spend log, Q&A memory, and reflection notes. Not the shared graph.
cost.json
memory/
reflections/

# Dated pre-overwrite backup and in-progress writes.
[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
.graph.tmp.json
.graph.html.stale
*.pending.json
